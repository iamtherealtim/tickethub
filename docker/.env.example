# TicketHub — settings for compose.yaml. Save as ".env" next to it
# (in Dockge/Portainer: paste into the stack's .env editor).
#
# Change anything here and run `docker compose up -d` (Dockge: Deploy) to
# apply it. Full HTTPS guide:
# https://github.com/iamtherealtim/tickethub/blob/main/docs/https.md

# ------------------------------------------------------------------- required
# Database password — any long random string. Set it once, before first start.
DB_PASSWORD=

# ------------------------------------------------------------ address + HTTPS
# The name people type, without https://, with its DNS record pointing at this
# server. Empty = local demo on http://localhost (no certificate needed).
TICKETHUB_DOMAIN=

# Where the certificate comes from (used when TICKETHUB_DOMAIN is set):
#   auto      Let's Encrypt. Public sites: ports 80 and 443 reachable from the internet.
#   dns       Let's Encrypt via your DNS provider's API — internal-only sites on a
#             public domain (helpdesk.corp.example.com). Fill in a provider below.
#   files     Your own certificate (e.g. from your company CA): put tls.crt (PEM,
#             with intermediates) and tls.key (PEM, no passphrase) in ./certs/
#   internal  TicketHub's own certificate authority — any name, even helpdesk.lan.
#             Install its root certificate on client PCs once (Admin → Address &
#             HTTPS has the download and the Group Policy / Intune steps).
#   upstream  Something in front (load balancer, Cloudflare Tunnel, proxy) already
#             does HTTPS and forwards plain http to port 80 here.
TICKETHUB_TLS=auto

# Optional: Let's Encrypt emails this address if a certificate is about to expire.
TICKETHUB_ACME_EMAIL=

# Where to listen. "80"/"443" = every address on this host. To use one IP only —
# e.g. an extra IP on a NAS whose own web UI already has 80/443 — prefix it:
#   TICKETHUB_HTTP_BIND=192.168.1.51:80
#   TICKETHUB_HTTPS_BIND=192.168.1.51:443
# A different port (8443) also works; the site address then includes it.
TICKETHUB_HTTP_BIND=80
TICKETHUB_HTTPS_BIND=443

# --- TICKETHUB_TLS=dns: pick one provider and fill in its credentials.
# TICKETHUB_DNS_PROVIDER=cloudflare
# CF_API_TOKEN=               # API token with Zone:DNS:Edit on the zone
#
# TICKETHUB_DNS_PROVIDER=azure
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP_NAME=  # the resource group holding the DNS zone
#
# TICKETHUB_DNS_PROVIDER=route53
# AWS_ACCESS_KEY_ID=          # omit both keys to use the EC2 instance role
# AWS_SECRET_ACCESS_KEY=

# --- TICKETHUB_TLS=files: other file names inside ./certs (default tls.crt / tls.key)
# TICKETHUB_CERT_FILE=helpdesk.crt
# TICKETHUB_KEY_FILE=helpdesk.key

# --- TICKETHUB_TLS=upstream: who may tell Caddy the visitor used HTTPS
# (default: the private ranges). Use your load balancer's address if you know it.
# TICKETHUB_UPSTREAM_PROXIES=10.0.0.5/32

# ------------------------------------------------------------------ optional
# Image version: "latest" (newest release), a release like "1.1" or "1.1.0",
# or "edge" (the main branch — for testing).
TICKETHUB_VERSION=latest

# Encrypts stored SMTP / SSO / webhook secrets. Generated on first start when
# empty; copy it here afterwards so it survives a recreated volume:
#   docker compose exec app grep encryption.key writable/.env
ENCRYPTION_KEY=

# production: no debug output, demo seeder blocked (and, with a domain,
# HTTPS-only + HSTS + Secure cookies). development: debug toolbar — laptops only.
CI_ENVIRONMENT=production

# Rarely needed: an explicit site address, overriding the one built from
# TICKETHUB_DOMAIN and the ports above.
# APP_BASE_URL=https://helpdesk.example.com/

# Scheduler cadence (seconds) and the UTC hour for the daily jobs.
# CRON_INTERVAL_SECONDS=300
# CRON_DAILY_AT=03

# Only for a throwaway demo: allow `php spark db:seed TicketHubSeeder` in production.
# TICKETHUB_ALLOW_DEMO_SEED=1
