# TicketHub — environment for docker-compose.yml
#
#   cp docker/.env.docker.example .env.docker
#
# docker/entrypoint.sh turns these into the application's .env on first boot
# (only when no .env is mounted). Change the passwords before going live.

# ---------------------------------------------------------------- application
# production: HTTPS-only + HSTS, Secure cookies, no debug output, demo seeder blocked.
# development: debug toolbar, plain http allowed (fine for a laptop).
CI_ENVIRONMENT=production

# Public URL with a trailing slash. Must be https:// in production unless you
# also set APP_FORCE_HTTPS=false (TLS terminated at a proxy that does not
# forward X-Forwarded-Proto).
APP_BASE_URL=http://localhost:8080/
# APP_FORCE_HTTPS=false
# APP_PROXY_IPS=10.0.0.5/32:X-Forwarded-For

# Encrypts stored SMTP / SSO / webhook secrets at rest. Leave empty to have one
# generated on first boot; set it explicitly so it survives a rebuilt volume.
# Generate with:  docker compose run --rm app php spark key:generate --show
ENCRYPTION_KEY=

# ------------------------------------------------------------------- database
# What the app connects to (the "db" service in docker-compose.yml).
DB_HOST=db
DB_PORT=3306
DB_NAME=tickethub
DB_USER=tickethub
DB_PASSWORD=change-me

# What MariaDB creates on first start. Keep these equal to DB_* above.
MARIADB_DATABASE=tickethub
MARIADB_USER=tickethub
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# ------------------------------------------------------------------ scheduler
# CRON_INTERVAL_SECONDS=300   # tickets:cron + tickethub:webhooks cadence
# CRON_DAILY_AT=03            # UTC hour for tickethub:retention + tickethub:digest

# ------------------------------------------------------------------ demo data
# Only for a throwaway demo: allows `php spark db:seed TicketHubSeeder` in production.
# TICKETHUB_ALLOW_DEMO_SEED=1
