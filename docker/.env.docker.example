# TicketHub — environment for docker-compose.yml
#
#   cp docker/.env.docker.example .env.docker
#
# Edit, then `docker compose up -d`. Changes apply on every start — address,
# certificate mode, database and environment included. Full guide: docs/https.md

# ------------------------------------------------------------ address + HTTPS
# The name people type, without https://. Point its DNS record at this server.
# Leave empty for a local demo on http://localhost (no certificate needed).
TICKETHUB_DOMAIN=

# Where the certificate comes from (only used when TICKETHUB_DOMAIN is set):
#   auto      Let's Encrypt. Public sites: ports 80 and 443 reachable from the internet.
#   dns       Let's Encrypt via your DNS provider's API. Internal-only sites that use a
#             public domain (helpdesk.corp.example.com). Set the provider block below.
#   files     Your own certificate — e.g. from your company CA — in docker/certs/
#             as tls.crt (PEM, with intermediates) and tls.key (PEM, no passphrase).
#   internal  TicketHub's own certificate authority. Anything, including names like
#             helpdesk.lan; install its root certificate on client PCs once
#             (Admin → Address & HTTPS has the download and GPO/Intune steps).
#   upstream  Something in front (load balancer, Cloudflare Tunnel, corporate
#             proxy) already does HTTPS and forwards plain http to port 80 here.
TICKETHUB_TLS=auto

# Optional: Let's Encrypt emails this address if a certificate is about to expire.
# TICKETHUB_ACME_EMAIL=it@example.com

# --- TICKETHUB_TLS=dns: pick one provider and fill in its credentials.
# TICKETHUB_DNS_PROVIDER=cloudflare
# CF_API_TOKEN=               # API token with Zone:DNS:Edit on the zone
#
# TICKETHUB_DNS_PROVIDER=azure
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP_NAME=  # the resource group holding the DNS zone
#
# TICKETHUB_DNS_PROVIDER=route53
# AWS_ACCESS_KEY_ID=          # omit both keys to use the EC2 instance role
# AWS_SECRET_ACCESS_KEY=

# --- TICKETHUB_TLS=files: other file names inside docker/certs/ (defaults tls.crt / tls.key)
# TICKETHUB_CERT_FILE=helpdesk.crt
# TICKETHUB_KEY_FILE=helpdesk.key

# --- TICKETHUB_TLS=upstream: who may tell Caddy the visitor used HTTPS
# (default: the private ranges). Use your load balancer's address if you know it.
# TICKETHUB_UPSTREAM_PROXIES=10.0.0.5/32

# Rarely needed: an explicit address (e.g. with a non-standard port from a
# docker-compose.override.yml). Normally derived from TICKETHUB_DOMAIN.
# APP_BASE_URL=https://helpdesk.example.com:8443/

# ---------------------------------------------------------------- application
# production: no debug output, demo seeder blocked; with a domain set, also
# HTTPS-only + HSTS + Secure cookies. development: debug toolbar (laptops only).
CI_ENVIRONMENT=production

# Encrypts stored SMTP / SSO / webhook secrets at rest. Leave empty to have one
# generated on first boot; set it explicitly so it survives a rebuilt volume.
# Generate with:  docker compose run --rm app php spark key:generate --show
ENCRYPTION_KEY=

# ------------------------------------------------------------------- database
# What the app connects to (the "db" service in docker-compose.yml).
DB_HOST=db
DB_PORT=3306
DB_NAME=tickethub
DB_USER=tickethub
DB_PASSWORD=change-me

# What MariaDB creates on first start. Keep these equal to DB_* above.
MARIADB_DATABASE=tickethub
MARIADB_USER=tickethub
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# ------------------------------------------------------------------ scheduler
# CRON_INTERVAL_SECONDS=300   # tickets:cron + tickethub:webhooks cadence
# CRON_DAILY_AT=03            # UTC hour for tickethub:retention + tickethub:digest

# ------------------------------------------------------------------ demo data
# Only for a throwaway demo: allows `php spark db:seed TicketHubSeeder` in production.
# TICKETHUB_ALLOW_DEMO_SEED=1
