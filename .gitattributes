# Normalise line endings: LF in the repository and on checkout everywhere.
* text=auto eol=lf

# Scripts that must stay LF even on Windows checkouts (Docker entrypoint, spark).
*.sh   text eol=lf
spark  text eol=lf
*.bat  text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary

# Keep generated / vendored noise out of GitHub's language stats and diffs
system/**            linguist-vendored
public/assets/**     linguist-vendored
composer.lock        -diff
northgate-service-desk.html linguist-documentation

# Files that should not ship in `git archive` exports
.github/         export-ignore
.editorconfig    export-ignore
.gitattributes   export-ignore
.gitignore       export-ignore
tests/           export-ignore
phpunit.dist.xml export-ignore
